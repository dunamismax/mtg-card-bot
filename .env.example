# MTG Card Bot Configuration
# Copy this file to .env and fill in your values

# Required: Your Discord bot token
MTG_DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Command prefix (default: !)
MTG_COMMAND_PREFIX=!

# Optional: Logging configuration
MTG_LOG_LEVEL=INFO
MTG_JSON_LOGGING=false

# Optional: Per-user rate limit. Users get bursts of MTG_COMMAND_BURST lookups,
# then one lookup per MTG_COMMAND_COOLDOWN seconds. Set the cooldown to 0 to disable.
MTG_COMMAND_COOLDOWN=2.0
MTG_COMMAND_BURST=3

# Optional: Seconds to cache Scryfall responses (Scryfall updates data daily)
MTG_CACHE_TTL=21600

# Optional: Register slash commands (/card, /price, /rules, ...) at startup
MTG_SYNC_COMMANDS=true
